{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radforge.dev/schemas/agent-candidate-specification.schema.json",
  "title": "NEXUS Agent Candidate Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "session_id", "revision", "objective", "mode", "inputs", "constraints", "acceptance_criteria", "required_capabilities", "risk_summary", "unresolved_questions", "review_ready", "candidate_digest"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "candidate_id": {"type": "string", "format": "uuid"},
    "session_id": {"type": "string", "format": "uuid"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 10000},
    "objective": {"type": "string", "minLength": 1, "maxLength": 8000},
    "mode": {"enum": ["app_build", "research", "data_analysis"]},
    "inputs": {
      "type": "array", "maxItems": 256, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^artifact:[A-Za-z0-9_./-]{1,240}$"}
    },
    "constraints": {"type": "array", "maxItems": 256, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "acceptance_criteria": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {"$ref": "#/$defs/criterion"}
    },
    "required_capabilities": {
      "type": "array", "maxItems": 128, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"}
    },
    "risk_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["highest_effect", "reasons"],
      "properties": {
        "highest_effect": {"enum": ["READ_ONLY", "WORKSPACE_WRITE", "SENSITIVE", "DESTRUCTIVE"]},
        "reasons": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
      }
    },
    "unresolved_questions": {"type": "array", "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "review_ready": {"type": "boolean"},
    "candidate_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "criterion": {
      "type": "object", "additionalProperties": false,
      "required": ["acceptance_id", "statement", "verification_method"],
      "properties": {
        "acceptance_id": {"type": "string", "pattern": "^AC-[A-Z0-9][A-Z0-9_-]{1,63}$"},
        "statement": {"type": "string", "minLength": 1, "maxLength": 2000},
        "verification_method": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    }
  }
}
