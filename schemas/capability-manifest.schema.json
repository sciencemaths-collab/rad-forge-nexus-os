{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radforge.dev/schemas/capability-manifest.schema.json",
  "title": "RAD Capability Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capability_id", "version", "kind", "description", "operations", "effects", "deterministic", "network_access", "approval_required", "qualification_required", "resource_limits"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "capability_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"},
    "kind": {"enum": ["NATIVE_TOOL", "ENGINE_OPERATION", "CONNECTOR", "HARDWARE_BACKEND", "DOMAIN_PACK"]},
    "description": {"type": "string", "minLength": 1, "maxLength": 1024},
    "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,127}$"}},
    "effects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["READ_ONLY", "WORKSPACE_WRITE", "SENSITIVE", "DESTRUCTIVE"]}},
    "deterministic": {"type": "boolean"},
    "network_access": {"enum": ["DENIED", "POLICY_SCOPED"]},
    "approval_required": {"type": "boolean"},
    "qualification_required": {"type": "boolean"},
    "resource_limits": {
      "type": "object", "additionalProperties": false,
      "required": ["timeout_seconds", "memory_mib"],
      "properties": {
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400},
        "memory_mib": {"type": "integer", "minimum": 1, "maximum": 1048576}
      }
    }
  }
}
