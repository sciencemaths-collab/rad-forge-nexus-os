{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radforge.dev/schemas/project.schema.json",
  "title": "NEXUS Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "name", "mode", "goal", "workspace", "providers", "policy", "acceptance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{2,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "mode": {"enum": ["app_build", "research", "data_analysis"]},
    "goal": {"type": "string", "minLength": 1, "maxLength": 10000},
    "workspace": {
      "type": "object", "additionalProperties": false, "required": ["root"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "read_only": {"type": "boolean", "default": false},
        "network_allowlist": {"type": "array", "items": {"type": "string", "format": "hostname"}, "uniqueItems": true, "default": []}
      }
    },
    "providers": {
      "type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/providerBinding"}
    },
    "secrets": {
      "type": "object", "additionalProperties": {"$ref": "#/$defs/secretReference"}, "default": {}
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["max_attempts", "max_elapsed_seconds", "max_cost_usd", "require_approval"],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 20},
        "max_elapsed_seconds": {"type": "integer", "minimum": 1, "maximum": 2592000},
        "max_cost_usd": {"type": "number", "minimum": 0},
        "require_approval": {"type": "array", "items": {"enum": ["SENSITIVE", "DESTRUCTIVE"]}, "uniqueItems": true}
      }
    },
    "acceptance": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "description", "verifier"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"},
          "description": {"type": "string", "minLength": 1},
          "verifier": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "providerBinding": {
      "type": "object", "additionalProperties": false, "required": ["adapter"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "credential": {"$ref": "#/$defs/secretReference"},
        "fallback": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "default": []}
      }
    },
    "secretReference": {"type": "string", "pattern": "^(env|vault|secret):[A-Za-z0-9_./-]+$"}
  }
}

